{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "text-reveal",
	"title": "Text Reveal",
	"type": "registry:block",
	"description": "Words arrive in reading order.",
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n\timport type { HTMLAttributes } from 'svelte/elements';\n\texport type Props = HTMLAttributes<HTMLSpanElement> & {\n\t\ttext: string;\n\t\tby?: 'word' | 'character';\n\t\tstagger?: number;\n\t};\n</script>\n\n<script lang=\"ts\">\n\tlet { text, by = 'word', stagger = 45, class: className, ...rest }: Props = $props();\n\tlet units = $derived(by === 'character' ? Array.from(text) : text.split(' '));\n</script>\n\n<span {...rest} class={className ?? ''}>\n\t{#each units as unit, index (index)}<span\n\t\t\tclass=\"reveal-unit\"\n\t\t\tstyle:animation-delay={`${index * stagger}ms`}\n\t\t\t>{unit}{by === 'word' && index < units.length - 1 ? ' ' : ''}</span\n\t\t>{/each}\n</span>\n\n<style>\n\t.reveal-unit {\n\t\tdisplay: inline-block;\n\t\tanimation: reveal 600ms cubic-bezier(0.23, 1, 0.32, 1) both;\n\t}\n\t@keyframes reveal {\n\t\tfrom {\n\t\t\topacity: 0;\n\t\t\ttransform: translateY(10px);\n\t\t\tfilter: blur(8px);\n\t\t}\n\t\tto {\n\t\t\topacity: 1;\n\t\t\ttransform: translateY(0);\n\t\t\tfilter: blur(0);\n\t\t}\n\t}\n\t@media (prefers-reduced-motion: reduce) {\n\t\t.reveal-unit {\n\t\t\tanimation: none;\n\t\t}\n\t}\n</style>\n",
			"type": "registry:component",
			"target": "interior/text-reveal.svelte"
		}
	]
}