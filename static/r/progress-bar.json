{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "progress-bar",
	"title": "Progress Bar",
	"type": "registry:block",
	"description": "Indeterminate handing over to determinate.",
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n\timport type { HTMLAttributes } from 'svelte/elements';\n\texport type Props = HTMLAttributes<HTMLDivElement> & { value?: number | null; label?: string };\n</script>\n\n<script lang=\"ts\">\n\tlet { value = null, label = 'Progress', class: className, ...rest }: Props = $props();\n\tlet percent = $derived(value == null ? null : Math.max(0, Math.min(100, value)));\n</script>\n\n<div {...rest} class=\"grid gap-2 {className ?? ''}\">\n\t<div class=\"flex items-center justify-between text-[11px] text-ink-3\">\n\t\t<span>{label}</span><span class=\"tnum font-mono\">{percent == null ? 'Working' : `${percent}%`}</span>\n\t</div>\n\t<div class=\"mat-well relative h-2 overflow-hidden rounded-full\">\n\t\t<div class=\"absolute inset-y-0 left-0 rounded-full bg-accent transition-[width] duration-500\" style:width={percent == null ? '38%' : `${percent}%`} data-indeterminate={percent == null}></div>\n\t</div>\n</div>\n\n<style>\n\t[data-indeterminate='true'] { animation: drift 1.4s ease-in-out infinite alternate; }\n\t@keyframes drift { from { transform: translateX(-18%); width: 32%; } to { transform: translateX(180%); width: 38%; } }\n\t@media (prefers-reduced-motion: reduce) { [data-indeterminate='true'] { animation: none; } }\n</style>\n",
			"type": "registry:component",
			"target": "interior/progress-bar.svelte"
		}
	]
}