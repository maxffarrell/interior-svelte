{
	"extends": "$app/tsconfig",
	"include": ["src"],
	"compilerOptions": {
		"checkJs": false,
		"moduleResolution": "bundler",
		"paths": {
			"#lib/*": ["./src/lib/*"]
		},
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "./worker-configuration.d.ts"]
	}
}
